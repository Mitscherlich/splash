{
  "manifest_version": 3,
  "name": "Splash",
  "version": "0.1.0",
  "description": "Minimal terminal new tab shell for Chrome",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "tabs",
    "storage",
    "search"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
